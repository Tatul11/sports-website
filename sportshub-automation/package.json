{
  "name": "sportshub-automation",
  "version": "1.0.0",
  "description": "Football content automation for SportsHub.uz — football API + Claude API -> trilingual draft articles pushed to the CMS for human review.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "preview": "tsx src/index.ts preview",
    "report": "tsx src/index.ts report",
    "scan:previews": "tsx src/index.ts scan-previews",
    "scan:reports": "tsx src/index.ts scan-reports",
    "rewrite": "tsx src/index.ts rewrite",
    "telegram:watch": "tsx src/index.ts telegram-watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@mozilla/readability": "^0.5.0",
    "docx": "^9.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^173.0.0",
    "jsdom": "^25.0.1",
    "openai": "^7.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
