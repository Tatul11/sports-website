# ─── Claude (Anthropic) API ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used to draft articles. Sonnet = best balance of quality/cost for news.
# Model used to draft articles. Sonnet = best balance of quality/cost for news.
# Options: claude-sonnet-5 | claude-opus-4-8 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5

# ─── OpenAI API (Optional for image generation) ───────────────────────────────
OPENAI_API_KEY=

# ─── Football API (API-Football / api-sports.io v3) ───────────────────────
# Get a key at https://www.api-football.com/  (verify Uzbekistan coverage first)
FOOTBALL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FOOTBALL_API_BASE=https://v3.football.api-sports.io
# Comma-separated league IDs to monitor (find them on the provider's coverage page).
# Example placeholders — replace with real IDs (e.g. UZ Super League + EPL + La Liga).
MONITOR_LEAGUE_IDS=
SEASON=2026

# ─── Your CMS / admin panel (only needed for preview/report/scan:* commands) ──
# The endpoint your developer exposes to receive draft articles (see docs/cms-endpoint-contract.md)
CMS_API_URL=https://sportshub.uz/api/automation/drafts
CMS_API_TOKEN=your-shared-secret-bearer-token
# The author these automated drafts are attributed to (must exist in the CMS).
DEFAULT_AUTHOR_SLUG=redaksiya

# ─── Output (only needed for the `rewrite` command) ────────────────────────
# Where generated .docx files are saved locally.
# Defaults to ./output if unset.
OUTPUT_DIR=./output

# ─── Google Drive API (Optional for `rewrite` command) ─────────────────────
# If set, the script will also upload the generated .docx to this Google Drive folder.
# Requires a Service Account JSON with access to the folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=1EqWX_8MFc1llO3o0rs8B-E04mt_aok_p

# ─── Telegram (only needed for the `telegram:watch` command) ───────────────
# Bot token from @BotFather. Add the bot as admin of your channel.
TELEGRAM_BOT_TOKEN=
# Your channel's @username, or the numeric chat id (e.g. -1001234567890) if it's private.
TELEGRAM_CHANNEL_ID=

# Site base URL — telegram:watch reads {SITE_BASE_URL}/google-news-sitemap.xml
# (a Google News sitemap only ever contains the last ~48h of published articles).
SITE_BASE_URL=https://sportshub.uz

# ─── Behaviour ────────────────────────────────────────────────────────────
# Everything is created as a DRAFT. Never set this to publish without human review.
DRAFT_STATUS=draft
# How many hours ahead to look for upcoming fixtures when scanning for previews.
PREVIEW_LOOKAHEAD_HOURS=48
# How many hours back to look for finished fixtures when scanning for reports.
REPORT_LOOKBACK_HOURS=6
# Timezone offset for Uzbekistan (used for display/timestamps).
TZ_OFFSET=+05:00
